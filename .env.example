# Flask Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# API Client Configuration (for prediction testing)
# Should match FLASK_HOST and FLASK_PORT for local testing
API_HOST=127.0.0.1
API_PORT=5000

# Kaggle Configuration (optional - only needed for dataset download)
# Get your API credentials from https://www.kaggle.com/settings/account
# The kagglehub library will automatically use ~/.kaggle/kaggle.json
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# File Paths
MODELS_DIR=./models
DATA_DIR=./data
FLIGHT_DATA_PATH=./data/flights_sample_3m.csv

# Model Configuration
MODE=test
DELAY_THRESHOLD=0.05
RANDOM_STATE=0

# Model Training Settings
N_ESTIMATORS=200
MAX_DEPTH=20
MIN_SAMPLES_SPLIT=100
MIN_SAMPLES_LEAF=50
MAX_FEATURES=sqrt
TEST_SIZE=0.1
N_JOBS=-1

# Insurance Pricing
POLICY_PRICE_1=72.24
POLICY_PRICE_2=84.98
POLICY_PRICE_3=95.50
POLICY_PRICE_4=105.00
DEFAULT_POLICY_PRICE=72.24
PRICE_INCREASE_PER_INTERVAL=0.1
DELAY_INTERVAL_MINUTES=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
